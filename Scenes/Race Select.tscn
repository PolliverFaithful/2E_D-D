theme_override_fonts/font = ExtResource("2_gdq3k")
text = "Humans gain no inherent stat bonuses, as they vary so much person
to person. However, they do gain two benefits:

-- A Bonus Language (Due to proximity growing up)

-- 2 Bonus General Proficiencies (Due to diversity in culture & work)

"

